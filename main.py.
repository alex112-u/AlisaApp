from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
from kivy.uix.button import Button
from kivy.core.window import Window

Window.clearcolor = (0.12, 0.07, 0.13, 1)

class AlisaApp(App):
    def build(self):
        layout = BoxLayout(
            orientation="vertical",
            padding=20,
            spacing=15
        )

        titulo = Label(
            text="🌸 Alisa",
            font_size=36
        )

        bienvenida = Label(
            text="¡Hola! Soy Alisa. ¿De qué hablamos hoy?",
            font_size=18
        )

        self.mensaje = TextInput(
            hint_text="Escribe un mensaje...",
            size_hint_y=None,
            height=50,
            multiline=False
        )

        boton = Button(
            text="Enviar",
            size_hint_y=None,
            height=50
        )

        layout.add_widget(titulo)
        layout.add_widget(bienvenida)
        layout.add_widget(self.mensaje)
        layout.add_widget(boton)

        boton.bind(on_press=self.responder)

        return layout

    def responder(self, instance):
        texto = self.mensaje.text.strip()
        if texto:
            print("Tú:", texto)
            self.mensaje.text = ""

AlisaApp().run()
